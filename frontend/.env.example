# ProTrack frontend environment variables
#
# Development (frontend/.env.development):
#   VITE_API_URL=/api/v1
#   VITE_APP_URL=http://localhost:5173
#
# Production (frontend/.env.production):
#   VITE_API_URL=https://api.protrack.prosohm.com/api/v1
#   VITE_APP_URL=https://protrack.prosohm.com
#
# Shared:
#   VITE_APP_VERSION=1.0.0
#   VITE_RELEASE_CANDIDATE=RC4
#   VITE_RELEASE_LABEL=Internal Release
#   VITE_INTERNAL_RELEASE=true
#
# Backend (root or deployment env):
#   INTERNAL_RELEASE=true
#   PROTRACK_SECRET_KEY=<strong-secret>
#   PROTRACK_FRONTEND_URL=https://protrack.prosohm.com
#   PROTRACK_API_URL=https://api.protrack.prosohm.com
#   PROTRACK_CORS_ORIGINS=https://protrack.prosohm.com,http://localhost:5173
#   PROTRACK_APP_VERSION=1.0.0
#   PROTRACK_RELEASE_CANDIDATE=RC4
