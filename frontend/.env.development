# ProTrack frontend — development (Vite)
# Uses same-origin /api/v1 via Vite dev-server proxy (see vite.config.ts)

VITE_API_URL=/api/v1
VITE_APP_URL=http://localhost:5173
VITE_APP_VERSION=1.0.0
VITE_RELEASE_CANDIDATE=RC3
VITE_RELEASE_LABEL=Internal Release

# Optional: override Vite proxy target (backend origin without /api/v1)
# VITE_DEV_API_PROXY=http://127.0.0.1:8000
