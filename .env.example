# ProTrack backend configuration example.
# Copy to `.env` (git-ignored) and fill in real values for each environment.

# Deployment environment: development | production
# In production the app refuses to start with insecure secrets.
PROTRACK_ENV=development

# --- Required in production -------------------------------------------------
# JWT signing key. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
PROTRACK_SECRET_KEY=
# Fernet key for encrypting stored secrets (SMTP passwords, etc).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROTRACK_ENCRYPTION_KEY=

# --- URLs / CORS ------------------------------------------------------------
PROTRACK_FRONTEND_URL=https://protrack.prosohm.com
PROTRACK_API_URL=https://api.protrack.prosohm.com
PROTRACK_CORS_ORIGINS=https://protrack.prosohm.com

# --- Transport / edge hardening ---------------------------------------------
# Enable HSTS only when served over HTTPS (default: on in production).
PROTRACK_ENABLE_HSTS=true
# Comma-separated Host header allowlist (empty disables the check).
PROTRACK_TRUSTED_HOSTS=protrack.prosohm.com,api.protrack.prosohm.com
PROTRACK_MAX_REQUEST_BODY_BYTES=52428800
PROTRACK_MAX_UPLOAD_BYTES=26214400

# --- Rate limiting ----------------------------------------------------------
PROTRACK_RATE_LIMIT_ENABLED=true
PROTRACK_AUTH_RATE_LIMIT=10/minute

# --- Authentication policy --------------------------------------------------
PROTRACK_LOCKOUT_MAX_FAILED_ATTEMPTS=5
PROTRACK_LOCKOUT_WINDOW_MINUTES=15
PROTRACK_LOCKOUT_DURATION_MINUTES=30
PROTRACK_PASSWORD_EXPIRY_DAYS=0
PROTRACK_PASSWORD_HISTORY_COUNT=5
PROTRACK_SESSION_IDLE_TIMEOUT_MINUTES=0

# --- Filesystem sandbox roots (os.pathsep separated) ------------------------
# Server-side path inputs (folder imports, email attachments) must resolve here.
# PROTRACK_IMPORT_SOURCE_ROOTS=
# PROTRACK_ATTACHMENT_ROOTS=

# --- Soft-launch flag -------------------------------------------------------
# Set to false before production deployment.
INTERNAL_RELEASE=true
