# ProTrack frontend — development (Vite)
# Uses same-origin /api/v1 via Vite dev-server proxy (see vite.config.ts)

VITE_API_URL=/api/v1
VITE_APP_URL=http://localhost:5173
VITE_APP_VERSION=1.0.0
VITE_RELEASE_CANDIDATE=RC5
VITE_RELEASE_LABEL=Internal Release

# Internal Release (soft launch): skip forced password change redirects.
# Set to false before production deployment.
VITE_INTERNAL_RELEASE=true

# Vite dev-server proxy target (backend origin without /api/v1).
# Must match the port your backend runs on (see terminal running uvicorn).
VITE_DEV_API_PROXY=http://127.0.0.1:8002
